# ==============================================================================
# BIZCORE — Environment Configuration Template
# All keys must be populated with appropriate environment credentials.
# Do NOT commit production secrets to version control.
# ==============================================================================

# Server Runtime & Port Configuration
PORT=3000
NODE_ENV=development

# Server Payment Gateway Cryptographic Secrets
PAYMENT_GATEWAY_SECRET=replace_with_server_hmac_sha256_secret
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret_key

# SMS & Communication Providers (Optional in Development)
FAST2SMS_API_KEY=replace_with_fast2sms_api_key_or_leave_empty_for_in_memory_otp
RESEND_API_KEY=replace_with_resend_api_key_or_leave_empty

# Google Workspace / OAuth 2.0 Integration (Client-Side)
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com

# Firebase Firestore & Auth Configuration (VITE_ prefixed for Client Access)
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-studio-autobillsmartkha-03453497-c72f-478c-b3cf-5e8a8f2f0b18
VITE_FIREBASE_STORAGE_BUCKET=replace_with_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_firebase_app_id
